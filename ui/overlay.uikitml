<!--
  Intro / pause / result card. Text and button labels are set at runtime.
-->
<style>
  .root { flex-direction: column; width: 460px; padding-top: 18px; padding-bottom: 18px; padding-left: 26px; padding-right: 26px; }
  .title { font-size: 28px; font-weight: 700; color: #1d5f6b; }
  .title:dark { color: #7fe3ea; }
  .body { font-size: 15px; color: #2b2b2b; margin-top: 8px; width: 100%; }
  .body:dark { color: rgba(255, 255, 255, 0.9); }
  .line { font-size: 14px; color: #444444; margin-top: 6px; width: 100%; }
  .line:dark { color: rgba(255, 255, 255, 0.8); }
  .buttons { flex-direction: row; gap: 12px; margin-top: 16px; }
</style>
<Panel id="root" class="root">
  <div id="ov-title" class="title">TerraCity</div>
  <div id="ov-body" class="body">Shape Tomorrow</div>
  <div id="ov-line-1" class="line">-</div>
  <div id="ov-line-2" class="line">-</div>
  <div id="ov-line-3" class="line">-</div>
  <div id="ov-line-4" class="line">-</div>
  <div id="ov-line-5" class="line">-</div>
  <div class="buttons">
    <Button id="ov-primary"><ButtonIcon><Play></Play></ButtonIcon><ButtonLabel id="ov-primary-label">Start</ButtonLabel></Button>
    <Button id="ov-secondary" variant="secondary"><ButtonLabel id="ov-secondary-label">Compare A/B</ButtonLabel></Button>
  </div>
</Panel>
